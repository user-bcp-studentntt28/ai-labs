# Copia este archivo a .env (ignorado por Git) y completa los valores.
# URL base del API mock (solo lectura).
MOCK_BASE_URL=https://bcp-wallet-mock.yefri.workers.dev/groups/3
# Modelo de GitHub Copilot (id que reporta el SDK: claude-sonnet-5.5, claude-sonnet-5, claude-haiku-5.5, ...).
AGENT_MODEL=claude-sonnet-5.5
# Token de GitHub con acceso a Copilot. Orden de busqueda: COPILOT_GITHUB_TOKEN > GH_TOKEN > GITHUB_TOKEN
# y, si no hay ninguno, `gh auth token`. Lo recomendado es NO definirlos aqui y usar `gh auth login`.
# COPILOT_GITHUB_TOKEN=
# Origenes permitidos por CORS (lista separada por comas).
ALLOWED_ORIGINS=http://localhost:4200
# Timeouts en segundos.
MOCK_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=60
